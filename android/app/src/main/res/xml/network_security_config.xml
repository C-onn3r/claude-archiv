<?xml version="1.0" encoding="utf-8"?>
<!-- Der Server ist frei konfigurierbar (auch http://192.168.x.x im Heimnetz); für Internet-Betrieb HTTPS verwenden. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
