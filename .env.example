# Alle Werte sind optional – die Defaults sind für den Betrieb hinter einem Reverse-Proxy sinnvoll.

# --- Server ---
HOST=0.0.0.0
PORT=3000
# Verzeichnis für Datenbank (SQLite), Archive und das automatisch erzeugte JWT-Secret
DATA_DIR=./data
# Gebautes Frontend (wird automatisch erkannt, wenn ../frontend/dist existiert)
# FRONTEND_DIR=../frontend/dist
# Hinter nginx/Caddy/Traefik: Client-IP aus X-Forwarded-For übernehmen (Rate-Limits)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Authentifizierung ---
# Mindestens 32 Zeichen. Leer = wird einmalig erzeugt und in DATA_DIR/jwt-secret.key gespeichert.
# JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
# Gültigkeit der Zugriffslinks für Proxy-/Archiv-Inhalte (iframe/WebView)
CONTENT_TOKEN_TTL_SEC=43200
# Der erste registrierte Benutzer wird immer Administrator. Danach nur mit true selbst registrierbar.
ALLOW_REGISTRATION=false

# --- Sicherheit ---
# NUR für Tests/Heimnetz: erlaubt Proxy/Archivierung für localhost und private IP-Bereiche (SSRF-Schutz aus!)
ALLOW_PRIVATE_NETWORKS=false
# Kommagetrennte Origins, die die API per CORS nutzen dürfen (z. B. Web-Frontend auf anderer Domain).
# Native Clients (Android) brauchen kein CORS.
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=20

# --- Proxy ---
PROXY_TIMEOUT_MS=20000
PROXY_MAX_BUFFERED_BYTES=15728640

# --- Archivierung ---
ARCHIVE_CONCURRENCY=2
ARCHIVE_TIMEOUT_MS=20000
ARCHIVE_MAX_ASSET_BYTES=26214400
ARCHIVE_MAX_TOTAL_BYTES=262144000
ARCHIVE_MAX_ASSETS=1000
ARCHIVE_FETCH_CONCURRENCY=8
ARCHIVE_MAX_IFRAME_DEPTH=1
