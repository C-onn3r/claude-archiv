{
  "name": "web-archiver",
  "private": true,
  "version": "1.0.0",
  "description": "Persönlicher Web-Archivierer & Proxy-Service",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "openapi": "npm run openapi -w backend"
  },
  "engines": {
    "node": ">=22.12"
  }
}
